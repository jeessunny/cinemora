# Copy this file to android/keystore.properties (untracked) or set environment variables:
#   KEYSTORE_FILE, STORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD
# NEVER commit android/keystore.properties or any *.jks/*.keystore files to version control.

storeFile=/absolute/path/to/.cinemora-signing/cinemora-release.jks
keyAlias=cinemora
storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
